{
  "name": "knowledge_island",
  "version": "1.0.0",
  "description": "SSR project",
  "scripts": {
    "lint:prettier": "prettier --write \"**/*.{js,ts,mjs,cjs,json,jsx,tsx,css,less,scss,vue,html,md}\"",
    "lint:eslint": "eslint",
    "commit": "git-cz",
    "precommit": "lint-staged",
    "prepare": "husky",
    "build:packages": "pnpm -F utils build && pnpm -F schemas build && pnpm -F lexical build && pnpm -F error build",
    "build:frontend": "pnpm -F frontend build",
    "dev:frontend": "pnpm -F frontend dev",
    "create:db": "pnpm -F backend create:db && pnpm -F backend migration:generate:dev && pnpm -F backend migration:run:dev",
    "update:db": "pnpm -F backend migration:generate:dev && pnpm -F backend migration:run:dev",
    "start:frontend": "pnpm -F frontend start",
    "start:backend": "pnpm -F backend start:dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2",
    "pnpm": ">=10.15.1"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "dependencies": {
    "@knowledge_island/error": "workspace:*",
    "@knowledge_island/lexical": "workspace:*",
    "@knowledge_island/schemas": "workspace:*",
    "@knowledge_island/utils": "workspace:*",
    "@lexical/extension": "^0.45.0",
    "@lexical/headless": "^0.45.0",
    "@lexical/history": "^0.45.0",
    "@lexical/html": "^0.45.0",
    "@lexical/link": "^0.45.0",
    "@lexical/react": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/selection": "^0.45.0",
    "@lexical/utils": "^0.45.0",
    "isomorphic-dompurify": "^3.12.0",
    "katex": "^0.16.45",
    "lexical": "^0.45.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "commitizen": "^4.3.1",
    "cz-git": "^1.12.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  }
}
